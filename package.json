{
  "name": "theraskill-agent",
  "version": "0.5.0",
  "description": "TheraSkillAgent local workbench launcher",
  "private": true,
  "scripts": {
    "install:workbench": "npm install",
    "dev:workbench": "npm run dev --workspace=theraskill-agent-workbench",
    "build:workbench": "npm run build --workspaces",
    "build": "npm run build --workspaces"
  },
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "views/theraskill/workbench",
    "views/theraskill/support_assistant",
    "views/theraskill/simulation_console",
    "views/theraskill/expert_studio"
  ]
}
